[Unit]
Description=Cloudflare Tunnel for Route Forest
Wants=network-online.target route-forest.service
After=network-online.target route-forest.service

[Service]
Type=simple
ExecStart=/home/m-osuke/.local/bin/cloudflared tunnel --no-autoupdate run --token-file /home/m-osuke/.config/route-forest/cloudflared.token
Restart=always
RestartSec=5s
TimeoutStopSec=15s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6
RestrictSUIDSGID=true
UMask=0077

[Install]
WantedBy=default.target
