ROUTE_HMAC_SECRET=replace-with-at-least-32-random-characters
PUBLIC_ORIGIN=https://route.example.com
CONSENT_VERSION=route-observation-v2
HOST=127.0.0.1
PORT=8080
TRACEROUTE_BIN=traceroute
TRACEROUTE_METHOD=icmp
TRACEROUTE_FALLBACK_METHOD=udp
TRACEROUTE_IPV6_ENABLED=true
TRACEROUTE_MAX_HOPS=24
TRACEROUTE_HOP_WAIT_SECONDS=0.5
TRACEROUTE_TIMEOUT_MS=12000
TRACEROUTE_MAX_OUTPUT_BYTES=131072
MEASUREMENT_CONCURRENCY=2
MEASUREMENT_QUEUE_CAPACITY=20
MEASUREMENT_COOLDOWN_MS=60000
MEASUREMENT_RECORD_TTL_MS=900000
